rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/Users/$(request.auth.uid))
        && get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    function isActiveStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/Users/$(request.auth.uid))
        && get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.status == 'ACTIVE';
    }

    // User profiles are keyed by Firebase Auth UID. A signed-in user may create
    // only a pending, non-privileged profile for their own UID. ADMIN must
    // provision ACTIVE access and privileged roles. This prevents a new account
    // from granting itself ADMIN/ACTIVE access through the client.
    match /Users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && (
        isAdmin() || (
          request.auth.uid == uid
          && (!('role' in request.resource.data) || request.resource.data.role == 'USER')
          && (!('status' in request.resource.data) || request.resource.data.status == 'PENDING')
        )
      );
      allow update: if signedIn() && (
        isAdmin() || (
          request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
        )
      );
      allow delete: if isAdmin();
    }

    // All operational data is restricted to provisioned active staff.
    // Destructive operations remain admin-only for auditability.
    match /{collection}/{id} {
      allow read, create, update: if isActiveStaff();
      allow delete: if isAdmin();
    }
  }
}
