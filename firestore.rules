rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // The application currently uses Firebase Authentication as the access gate.
    // Fine-grained staff roles are represented in Users and will be enforced by
    // the administrative policy layer as role profiles are provisioned.
    match /Users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // Operational collections are private to authenticated Credlock staff.
    match /{collection}/{id} {
      allow read, create, update: if signedIn();
      allow delete: if signedIn();
    }
  }
}
