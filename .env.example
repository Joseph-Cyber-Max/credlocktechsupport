# Firebase Realtime Database — PRIMARY backend
# These are client-safe Firebase web configuration values. Firebase Security Rules
# must enforce authenticated access; never put service-account credentials here.
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_DATABASE_URL=https://YOUR_PROJECT-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID

# Google Apps Script — SECONDARY/reporting backend
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Server-side secrets for Netlify Functions only (NEVER VITE_*)
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# OPENAI_API_KEY=
